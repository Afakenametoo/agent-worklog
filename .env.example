HOST=127.0.0.1
PORT=4178
TIMEZONE=Asia/Shanghai
REPORT_AUTHOR=zsq
WEEKLY_REPORT_ROOT=D:\code\weekly_report
WEEKLY_TEMPLATE_PATH=D:\code\weekly_report\2026-004\01驻场人员研发周报模板.docx

# 二选一或同时配置。Key 只由服务端读取，前端不会获得明文。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
ANTHROPIC_API_KEY=
# Anthropic 兼容服务可改用 Bearer Token 和自定义端点。
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-5
DEFAULT_AI_PROVIDER=openai

# 可选来源覆盖；留空时使用当前用户目录。
CODEX_HOME=
CLAUDE_HOME=
ENABLE_WSL_CLAUDE=true
EXCLUDED_PROJECTS=
